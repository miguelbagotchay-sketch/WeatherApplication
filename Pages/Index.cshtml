@page
@model IndexModel

<!DOCTYPE html>
<html>
<head>
    <title>Weather Application</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eaf6ff;
            margin: 0;
            padding: 30px;
        }
        .container {
            max-width: 700px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }
        h1 {
            text-align: center;
            color: #0b2c4d;
            font-size: 34px;
        }
        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 25px;
        }
        .search-form {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
        }
        .search-form input {
            flex: 1;
            padding: 12px;
            border: 2px solid #d0d7de;
            border-radius: 8px;
            font-size: 16px;
        }
        .search-form button {
            padding: 12px 25px;
            background: #087ff5;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
        }
        .search-form button:hover {
            background: #066bd1;
        }
        .error {
            color: red;
            background: #ffebee;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
        }
        .debug-box {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
            font-size: 13px;
            font-family: monospace;
            white-space: pre-wrap;
            word-break: break-all;
            max-height: 300px;
            overflow: auto;
            border: 1px solid #ddd;
        }
        .debug-box strong {
            color: #0b2c4d;
        }
        .weather-info {
            margin-top: 20px;
        }
        .weather-info h2 {
            color: #0b2c4d;
            font-size: 26px;
        }
        .weather-info p {
            font-size: 17px;
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .forecast-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-top: 15px;
        }
        .forecast-day {
            background: #f7faff;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid #e8edf3;
        }
        .forecast-day .day {
            font-weight: bold;
            font-size: 13px;
        }
        .forecast-day .temp {
            font-size: 18px;
            font-weight: bold;
            color: #087ff5;
            margin: 5px 0;
        }
        .forecast-day .condition {
            font-size: 12px;
            color: #666;
        }
        .forecast-day img {
            width: 50px;
            height: 50px;
        }
        .welcome {
            text-align: center;
            color: #888;
            padding: 40px 20px;
        }
        .welcome span {
            font-size: 50px;
            display: block;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>🌦️ Weather Application</h1>
    <p class="subtitle">Check current weather and 5-day forecast</p>

    <form method="get" class="search-form">
        <input type="text" name="city" placeholder="Enter city name (e.g., Manila)" required />
        <button type="submit">Search</button>
    </form>

    
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">❌ @Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.City) && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="weather-info">
            <h2>📍 @Model.City</h2>
            <p><strong>Temperature:</strong> @Model.Temperature °C</p>
            <p><strong>Condition:</strong> @Model.Condition</p>
            <p><strong>Humidity:</strong> @Model.Humidity %</p>
            <p><strong>Wind Speed:</strong> @Model.WindSpeed m/s</p>

            <h3 style="margin-top:25px;">📅 5-Day Forecast</h3>
            @if (Model.Forecast.Count > 0)
            {
                <div class="forecast-grid">
                    @foreach (var day in Model.Forecast)
                    {
                        <div class="forecast-day">
                            <div class="day">@DateTime.Parse(day.Date).ToString("ddd, MMM d")</div>
                            <img src="https://openweathermap.org/img/wn/@(day.Icon)@@2x.png" alt="@day.Condition" />
                            <div class="temp">@day.Temperature °C</div>
                            <div class="condition">@day.Condition</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="text-align:center;color:#888;">Forecast not available</p>
            }
        </div>
    }

    @if (!Model.HasSearched && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="welcome">
            <span>🔍</span>
            Enter a city name above to see the weather
        </div>
    }
</div>

</body>
</html>